---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Heading from '../components/Heading.astro';
import Text from '../components/Text.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Startseiteninhalt fehlt.');
const { Content } = await render(page);
const sections = page.data.homeSections;
if (!sections) throw new Error('Redaktionelle Startseitenabschnitte fehlen.');

const services = [
  { ...sections.services.cards.leadership, href: '/angebote/fuehrung' },
  { ...sections.services.cards.teamwork, href: '/angebote/teamwork' },
  { ...sections.services.cards.change, href: '/angebote/change' },
  { ...sections.services.cards.moderation, href: '/angebote/moderation' },
];
---

<BaseLayout
  title={page.data.seoTitle}
  schemaTitle={page.data.title}
  description={page.data.description}
  section="home"
  image={page.data.socialImage}
  imageAlt={page.data.socialImageAlt}
  updatedAt={page.data.updatedAt}
  noindex={page.data.noindex}
>
  <Hero eyebrow={page.data.eyebrow} points={page.data.heroTexts} {...sections.hero} />

  <Section class="bg-white">
    <div class="grid items-start gap-9 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-about-text">{sections.working.eyebrow}</p>
        <Heading class="mt-4">{sections.working.title}</Heading>
      </div>
      <div class="prose-fabian"><Content /></div>
    </div>
  </Section>

  <Section class="border-y border-line bg-paper">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-services-text">{sections.services.eyebrow}</p>
        <Heading class="mt-4 max-w-3xl">{sections.services.title}</Heading>
      </div>
      <Button href="/angebote" variant="text">{sections.services.linkLabel}</Button>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {services.map((service, index) => <Card {...service} number={`0${index + 1}`} />)}
    </div>
  </Section>

  <Section class="bg-white">
    <div class="grid items-start gap-8 lg:grid-cols-[0.6fr_1.4fr] lg:gap-16">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-about-text">{sections.profile.eyebrow}</p>
        <Heading class="mt-4">{sections.profile.title}</Heading>
      </div>
      <div>
        <Text class="max-w-2xl text-lg">{sections.profile.text}</Text>
        <Button href="/ueber-mich/profil" class="mt-7">{sections.profile.linkLabel}</Button>
      </div>
    </div>
  </Section>

  <Section class="bg-ink text-white">
    <div class="mx-auto max-w-4xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-about">{sections.testimonial.eyebrow}</p>
      <blockquote class="mt-6 font-display text-[clamp(1.7rem,3.4vw,2.9rem)] leading-[1.28] text-balance">„{sections.testimonial.quote}“</blockquote>
      <p class="mt-6 text-sm text-white/70">{sections.testimonial.attribution}</p>
      <Button href="/ueber-mich/kundenfeedback" variant="light" class="mt-7">{sections.testimonial.linkLabel}</Button>
    </div>
  </Section>

  <Section class="bg-contact/5">
    <div class="grid items-end gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-contact-text">{sections.contact.eyebrow}</p>
        <Heading class="mt-4 max-w-4xl">{sections.contact.title}</Heading>
        <Text class="mt-4 max-w-2xl">{sections.contact.text}</Text>
      </div>
      <Button href="/kontakt">{sections.contact.buttonLabel}</Button>
    </div>
  </Section>
</BaseLayout>
