---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import Text from '../components/Text.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Seite nicht gefunden | Meike Fabian" description="Die gewünschte Seite wurde nicht gefunden." section="legal">
  <Container class="py-28 text-center sm:py-40">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--accent-text)]">Fehler 404</p>
    <Heading as="h1" class="mt-5">Diese Seite gibt es nicht.</Heading>
    <Text class="mx-auto mt-6 max-w-xl">Vielleicht wurde die Adresse geändert oder ein Link ist nicht mehr aktuell.</Text>
    <Button href="/" class="mt-9">Zur Startseite</Button>
  </Container>
</BaseLayout>
