---
import Container from './Container.astro';
import PageHeader from './PageHeader.astro';
import SubNavigation from './SubNavigation.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getSectionNavigation } from '../data/navigation';
import portrait from '../assets/images/meike-fabian-portrait.jpg';
import articleCover from '../assets/images/aus-der-krise-fuehren-cover.png';
import ContactPanel from './ContactPanel.astro';
import PageAside from './PageAside.astro';

interface Props {
  title: string;
  eyebrow?: string;
  description: string;
  section: string;
  secondColumn?: string;
  notice?: string;
  media?: 'article-cover';
  variant?: 'default' | 'profile' | 'leadership' | 'news' | 'contact' | 'hub-about' | 'hub-services' | 'references' | 'testimonials' | 'connections';
}

const { title, eyebrow, description, section, secondColumn, notice, media, variant = 'default' } = Astro.props;
const subnav = getSectionNavigation(section);
const contentPages = await getCollection('pages', ({ data }) => !data.draft);
const labels = new Map(contentPages.map((entry) => [entry.id, entry.data.navTitle]));
const sectionDirectories: Record<string, string> = {
  about: 'ueber-mich',
  services: 'angebote',
  news: 'aktuelles',
  contact: 'kontakt',
};
const sectionIndexItems = section === 'news' ? [{ label: 'Übersicht', href: '/aktuelles' }] : [];
const configuredItems = [...sectionIndexItems, ...subnav.map((item) => ({
  ...item,
  label: labels.get(item.href.replace(/^\//, '')) ?? item.label,
})).filter((item) => labels.has(item.href.replace(/^\//, '')))];
const configuredHrefs = new Set(configuredItems.map((item) => item.href));
const sectionDirectory = sectionDirectories[section];
const additionalItems = sectionDirectory
  ? contentPages
      .filter((entry) => entry.id.startsWith(`${sectionDirectory}/`))
      .map((entry) => ({ label: entry.data.navTitle, href: `/${entry.id}` }))
      .filter((item) => !configuredHrefs.has(item.href))
      .sort((a, b) => a.label.localeCompare(b.label, 'de'))
  : [];
const subnavItems = [...configuredItems, ...additionalItems];
const isWide = ['hub-about', 'hub-services', 'references', 'testimonials', 'connections'].includes(variant);
const isCustomGrid = ['testimonials', 'connections'].includes(variant);
const showSubnav = subnavItems.length > 0 && !['hub-about', 'hub-services', 'news'].includes(variant);
const isServiceDetail = section === 'services' && !['hub-services'].includes(variant);
---

<PageHeader title={title} eyebrow={eyebrow} description={description} />
{showSubnav && <SubNavigation items={subnavItems} currentPath={Astro.url.pathname} />}

<Container class="py-12 sm:py-14 lg:py-16">
  {notice && (
    <aside class="mb-10 rounded-2xl border border-contact/30 bg-contact/5 px-5 py-4 text-sm font-semibold text-contact-text" role="note">
      {notice}
    </aside>
  )}

  <article class:list={[
    'mx-auto grid min-w-0 gap-10 sm:gap-12 lg:gap-16',
    secondColumn || media
      ? 'max-w-6xl lg:grid-cols-[minmax(0,1fr)_20rem]'
      : isWide
        ? 'max-w-6xl'
        : 'max-w-4xl',
  ]}>
    {secondColumn && variant !== 'contact' && isServiceDetail && (
      <PageAside content={secondColumn} class="lg:col-start-2 lg:row-start-1 lg:mt-2" />
    )}

    {variant === 'profile' && (
      <figure class="mx-auto w-full max-w-[10.5rem] self-start overflow-hidden rounded-xl bg-paper sm:max-w-52 lg:col-start-2 lg:row-start-1 lg:mt-2 lg:max-w-none">
        <Image
          src={portrait}
          alt="Porträt von Meike Fabian"
          widths={[366, 600]}
          sizes="(min-width: 1024px) 20rem, 100vw"
          class="aspect-[3/4] w-full object-cover"
        />
      </figure>
    )}

    <div class="min-w-0 lg:col-start-1 lg:row-span-2 lg:row-start-1">
      <div class:list={[
        !isCustomGrid && 'prose-fabian',
        variant === 'profile' && 'prose-profile',
        variant === 'leadership' && 'prose-leadership',
        variant === 'contact' && 'prose-contact',
        (variant === 'hub-about' || variant === 'hub-services') && 'prose-hub',
        variant === 'references' && 'prose-references',
      ]}><slot /></div>
      <slot name="after-content" />
    </div>

    {media === 'article-cover' && (
      <figure class="mx-auto w-full max-w-72 self-start lg:col-start-2 lg:row-start-1 lg:mt-2 lg:max-w-none">
        <div class="overflow-hidden rounded-xl border border-line bg-white shadow-[0_22px_60px_-40px_rgba(23,33,37,0.5)]">
          <Image
            src={articleCover}
            alt="Erste Seite des Fachartikels Aus der Krise führen"
            widths={[360, 560]}
            sizes="(min-width: 1024px) 20rem, 18rem"
            class="w-full"
          />
        </div>
        <figcaption class="mt-3 text-sm leading-6 text-muted">Erste Seite des Fachartikels „Aus der Krise führen“</figcaption>
      </figure>
    )}

    {secondColumn && variant === 'contact' && <ContactPanel content={secondColumn} />}

    {secondColumn && variant !== 'contact' && !isServiceDetail && (
      <PageAside
        content={secondColumn}
        class={variant === 'profile'
          ? 'lg:col-start-2 lg:row-start-2'
          : media
            ? 'lg:col-start-2 lg:row-start-2'
            : 'lg:col-start-2 lg:row-start-1 lg:mt-2'}
      />
    )}
  </article>
</Container>
