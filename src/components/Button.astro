---
import { withBase } from '../utils/paths';

interface Props {
  href: string;
  variant?: 'solid' | 'light' | 'text';
  class?: string;
}

const { href, variant = 'solid', class: className = '' } = Astro.props;
const resolvedHref = withBase(href);
---

<a
  href={resolvedHref}
  class:list={[
    'group inline-flex min-h-12 items-center gap-3 rounded-full font-semibold no-underline transition duration-300',
    variant === 'solid'
      ? 'bg-ink px-6 py-3 text-white hover:bg-[var(--accent-text)]'
      : variant === 'light'
        ? 'border border-white bg-white px-6 py-3 text-ink hover:bg-paper'
        : 'text-ink hover:text-[var(--accent-text)]',
    className,
  ]}
>
  <slot />
  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
</a>
