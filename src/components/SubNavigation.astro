---
import { withBase, withoutBase } from '../utils/paths';

interface Item {
  label: string;
  href: string;
}

interface Props {
  items: Item[];
  currentPath: string;
}

const { items, currentPath: rawCurrentPath } = Astro.props;
const currentPath = withoutBase(rawCurrentPath);
---

<nav aria-label="Seitennavigation" class="border-b border-line bg-white">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-4 px-4 sm:flex sm:gap-7 sm:overflow-x-auto sm:px-8 lg:px-12">
    {items.map((item) => {
      const active = currentPath === item.href;

      return (
        <a
          href={withBase(item.href)}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'relative min-w-0 py-3 text-sm font-semibold hyphens-auto [overflow-wrap:anywhere] no-underline transition-colors sm:shrink-0 sm:py-5',
            active ? 'text-ink' : 'text-muted hover:text-ink',
          ]}
        >
          {item.label}
          {active && <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5 bg-[var(--accent)]"></span>}
        </a>
      );
    })}
  </div>
</nav>
