---
interface Item {
  label: string;
  href: string;
}

interface Props {
  items: Item[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;
---

<nav aria-label="Seitennavigation" class="relative border-b border-line bg-white">
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-9 bg-gradient-to-l from-white to-transparent sm:hidden" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-7xl snap-x gap-5 overflow-x-auto scroll-smooth px-4 pr-12 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:gap-7 sm:px-8 sm:pr-8 lg:px-12">
    {items.map((item) => {
      const active = currentPath === item.href;

      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'relative shrink-0 snap-start py-4 text-sm font-semibold no-underline transition-colors sm:py-5',
            active ? 'text-ink' : 'text-muted hover:text-ink',
          ]}
        >
          {item.label}
          {active && <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5 bg-[var(--accent)]"></span>}
        </a>
      );
    })}
  </div>
</nav>
