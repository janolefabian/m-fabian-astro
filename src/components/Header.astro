---
import Container from './Container.astro';
import Navigation from './Navigation.astro';
import { withBase } from '../utils/paths';
interface Props { pathname: string }
const { pathname } = Astro.props;
---

<header class="sticky top-0 z-30 border-b border-line/80 bg-white/95 backdrop-blur-sm">
  <Container class="flex min-h-22 items-center justify-between gap-2 py-4 sm:gap-6 lg:min-h-26">
    <a href={withBase('/')} class="min-w-0 shrink text-ink no-underline" aria-label="Meike Fabian – Startseite">
      <span class="block whitespace-nowrap text-[1.15rem] font-medium uppercase leading-none tracking-[0.025em] min-[360px]:text-[1.4rem] sm:text-[1.65rem] sm:tracking-[0.035em]">
        Meike <strong class="font-bold">Fabian</strong>
      </span>
      <span class="mt-1 block whitespace-nowrap text-center text-[0.66rem] leading-none text-muted min-[360px]:text-[0.78rem] sm:text-[0.9rem]">Supervision und Coaching</span>
    </a>
    <Navigation pathname={pathname} />
  </Container>
</header>
