---
interface Props {
  content: string;
}

const { content } = Astro.props;
const blocks = content.split(/\n\s*\n/).map((block) => block.trim()).filter(Boolean);
const title = blocks.shift() ?? 'Direkt Kontakt aufnehmen';
const entries = blocks.map((block) => {
  const [label, ...lines] = block.split('\n').map((line) => line.trim()).filter(Boolean);
  return { label, value: lines.join(' · '), lines };
});
const phone = entries.find((entry) => entry.label.toLowerCase() === 'telefon');
const email = entries.find((entry) => entry.label.toLowerCase() === 'e-mail');
const otherEntries = entries.filter((entry) => entry !== phone && entry !== email);
const phoneNumber = phone?.value.replace(/[^+\d]/g, '');
const internationalPhoneNumber = phoneNumber?.startsWith('0') ? `+49${phoneNumber.slice(1)}` : phoneNumber;
const phoneHref = internationalPhoneNumber ? `tel:${internationalPhoneNumber}` : undefined;
const emailHref = email ? `mailto:${email.value}` : undefined;
---

<aside class="order-first self-start rounded-3xl border border-line bg-paper p-6 sm:p-7 lg:order-none lg:col-start-2 lg:row-start-1 lg:mt-2">
  <p class="text-xs font-bold uppercase tracking-[0.18em] text-contact-text">Kontakt</p>
  <h2 class="mt-3 font-display text-[1.65rem] font-medium leading-tight text-ink">{title}</h2>

  <div class="mt-6 grid gap-3">
    {email && (
      <a href={emailHref} class="group flex min-h-12 items-center justify-between gap-3 rounded-full bg-ink px-5 py-3 font-semibold text-white no-underline transition hover:bg-contact-text">
        E-Mail schreiben <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    )}
  </div>

  <dl class="mt-7 space-y-5 border-t border-line pt-6 text-sm leading-6">
    {phone && (
      <div>
        <dt class="font-bold text-ink">{phone.label}</dt>
        <dd class="mt-1 text-muted"><a href={phoneHref} class="hover:text-contact-text">{phone.value}</a></dd>
      </div>
    )}
    {email && (
      <div>
        <dt class="font-bold text-ink">{email.label}</dt>
        <dd class="mt-1 break-all text-muted"><a href={emailHref} class="hover:text-contact-text">{email.value}</a></dd>
      </div>
    )}
    {otherEntries.map((entry) => (
      <div>
        <dt class="font-bold text-ink">{entry.label}</dt>
        <dd class="mt-1 text-muted">{entry.lines.map((line) => <span class="block">{line}</span>)}</dd>
      </div>
    ))}
  </dl>
</aside>
