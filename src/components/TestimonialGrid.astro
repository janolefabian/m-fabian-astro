---
interface Props {
  body: string;
}

const { body } = Astro.props;
const testimonials = [...body.matchAll(/^>\s*(.+)\n\n\*\*(.+)\*\*$/gm)].map((match) => ({
  quote: match[1].trim(),
  attribution: match[2].trim(),
}));
---

<div class="grid gap-5 md:grid-cols-2">
  {testimonials.map((testimonial, index) => (
    <figure class:list={[
      'flex flex-col justify-between rounded-3xl border border-line bg-paper p-6 sm:p-8',
      index === 0 && 'md:col-span-2 md:grid md:grid-cols-[1.3fr_0.7fr] md:items-end md:gap-12',
    ]}>
      <blockquote class:list={[
        'font-display leading-[1.48] text-ink',
        index === 0 ? 'text-[clamp(1.45rem,2.8vw,2.1rem)]' : 'text-[clamp(1.25rem,2vw,1.55rem)]',
      ]}>{testimonial.quote}</blockquote>
      <figcaption class="mt-7 border-t border-[var(--accent)] pt-4 text-sm font-semibold leading-6 text-muted md:mt-8">
        {testimonial.attribution}
      </figcaption>
    </figure>
  ))}
</div>
