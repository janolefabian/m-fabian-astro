---
import { withBase } from '../utils/paths';

interface Props {
  href?: string;
  eyebrow?: string;
  title: string;
  description: string;
  number?: string;
}

const { href, eyebrow, title, description, number } = Astro.props;
const Tag = href ? 'a' : 'article';
const resolvedHref = href ? withBase(href) : undefined;
---

<Tag
  href={resolvedHref}
  class="group relative flex min-h-0 flex-col justify-between gap-6 overflow-hidden rounded-[1.5rem] border border-line bg-white p-5 no-underline shadow-[0_20px_70px_-45px_rgba(23,33,37,0.4)] transition duration-300 hover:-translate-y-1 hover:border-[var(--accent)] sm:min-h-72 sm:gap-8 sm:rounded-[1.75rem] sm:p-8"
>
  <div class="flex items-center justify-between gap-4 text-xs font-bold uppercase tracking-[0.18em] text-muted">
    <span>{eyebrow}</span>
    {number && <span>{number}</span>}
  </div>
  <div>
    <h3 class="font-display text-[1.65rem] leading-tight text-ink sm:text-[clamp(1.8rem,3vw,2.5rem)]">{title}</h3>
    <p class="mt-3 text-[0.98rem] leading-6 text-muted sm:mt-4 sm:text-base sm:leading-7">{description}</p>
    {href && <span class="mt-4 inline-flex items-center gap-2 font-semibold text-ink group-hover:text-[var(--accent-text)] sm:mt-6">Mehr erfahren <span aria-hidden="true">→</span></span>}
  </div>
</Tag>
