---
import Container from './Container.astro';
import Heading from './Heading.astro';
import Text from './Text.astro';

interface Props { eyebrow?: string; title: string; description?: string }
const { eyebrow, title, description } = Astro.props;
---

<header class="relative overflow-hidden border-b border-line bg-paper py-7 sm:py-10 lg:py-14">
  <div class="absolute inset-y-0 left-0 w-1.5 bg-[var(--accent)]"></div>
  <Container>
    {eyebrow && <p class="mb-2 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[var(--accent-text)] sm:mb-3 sm:text-xs">{eyebrow}</p>}
    <Heading as="h1" size="lg" class="max-w-5xl">{title}</Heading>
    {description && <Text class="mt-3 max-w-3xl text-base leading-7 sm:mt-4 sm:text-lg sm:leading-8">{description}</Text>}
  </Container>
</header>
