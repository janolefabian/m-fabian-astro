---
import { getCollection } from 'astro:content';

const entries = (await getCollection('pages'))
  .filter((entry) => entry.id.startsWith('aktuelles/'))
  .sort((a, b) => b.data.order - a.data.order || a.data.title.localeCompare(b.data.title, 'de'));
---

{entries.length > 0 && (
  <section aria-labelledby="publications-heading" class="mt-12 border-t border-line pt-10 sm:mt-14 sm:pt-12">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-news-text">Zum Weiterlesen</p>
    <h2 id="publications-heading" class="mt-3 font-display text-[clamp(1.75rem,2.7vw,2.35rem)] font-medium leading-tight text-ink">Ausgewählte Beiträge</h2>
    <div class="mt-7 grid gap-5">
      {entries.map((entry) => (
        <a href={`/${entry.id}`} class="group grid gap-5 rounded-3xl border border-line bg-paper p-6 no-underline transition duration-300 hover:-translate-y-0.5 hover:border-news sm:grid-cols-[1fr_auto] sm:items-end sm:p-7">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-news-text">{entry.data.eyebrow ?? 'Veröffentlichung'}</p>
            <h3 class="mt-3 font-display text-[clamp(1.55rem,2.5vw,2rem)] font-medium leading-tight text-ink">{entry.data.title}</h3>
            <p class="mt-3 max-w-2xl text-base leading-7 text-muted">{entry.data.description}</p>
          </div>
          <span class="inline-flex items-center gap-2 font-semibold text-ink group-hover:text-news-text">Beitrag öffnen <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
        </a>
      ))}
    </div>
  </section>
)}
