---
import Container from './Container.astro';
import { withBase } from '../utils/paths';
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper py-12 sm:py-16">
  <Container class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <p class="text-xl font-bold uppercase tracking-[0.1em] text-ink">Meike Fabian</p>
      <p class="mt-3 max-w-md text-sm leading-6 text-muted">Supervision, Coaching, Organisationsberatung und Moderation für Führungskräfte, Teams und Organisationen.</p>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">Kontakt</p>
      <address class="mt-3 text-sm not-italic leading-7 text-ink">
        Krumme Straße 13<br />32756 Detmold<br />
        <a href="tel:+491751759556" class="hover:text-[var(--accent-text)]">0175 1759556</a><br />
        <a href="mailto:info@m-fabian.de" class="hover:text-[var(--accent-text)]">info@m-fabian.de</a>
      </address>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">Rechtliches</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={withBase('/impressum')} class="text-ink hover:text-[var(--accent-text)]">Impressum & Datenschutz</a></li>
        <li><a href={withBase('/agb')} class="text-ink hover:text-[var(--accent-text)]">AGB</a></li>
      </ul>
    </div>
  </Container>
  <Container class="mt-10 border-t border-line pt-6 text-xs text-muted">© {year} Meike Fabian</Container>
</footer>
